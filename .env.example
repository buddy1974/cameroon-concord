# Database — Hostinger MariaDB
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Set DB_SSL=true only when connecting to a managed DB with a valid TLS cert
DB_SSL=false

# Revalidation
REVALIDATE_SECRET=

# Auth — REQUIRED (no fallback; server will refuse to start without JWT_SECRET)
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_PASSWORD=

# Admin login credentials
ADMIN_EMAIL=

# AI — Anthropic
ANTHROPIC_API_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Email — Resend
RESEND_API_KEY=

# API
API_BASE_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=Cameroon Concord
NEXT_PUBLIC_API_URL=

# Automation key for n8n / server-to-server API calls (server-only, no NEXT_PUBLIC_ prefix)
AUTOMATION_API_KEY=

# Maintenance mode
MAINTENANCE_MODE=false
MAINTENANCE_PASSWORD=
# MAINTENANCE_TOKEN is derived from MAINTENANCE_PASSWORD via HMAC — leave blank to auto-derive
MAINTENANCE_TOKEN=

# IndexNow (search engine URL submission)
INDEXNOW_API_KEY=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Newsroom API v1 (TM / Telegram newsroom → this site). See docs/newsroom-api.md.
# "true" to enable /api/newsroom/v1/*; anything else → 503 API_DISABLED.
NEWSROOM_API_ENABLED=
# Optional. "false" blocks all newsroom writes (503 WRITES_DISABLED); reads keep working.
NEWSROOM_WRITES_ENABLED=
# HMAC secret shared with TM. Unique to this publication; must NOT equal AUTOMATION_API_KEY.
# Generate with: openssl rand -base64 32
NEWSROOM_SIGNING_SECRET=
# Optional comma-separated numeric Telegram user IDs treated as active publishers (owner bootstrap).
NEWSROOM_OWNER_TELEGRAM_IDS=
# Optional. Protects /api/newsroom/v1/cron/publish-scheduled (Vercel sends Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
